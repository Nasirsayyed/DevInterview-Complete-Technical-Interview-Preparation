{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "devinterview-api",
    "Audience": "devinterview-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5080",
    "DeepLinkScheme": "devinterview",
    "RequireEmailVerification": true,
    "SupportEmail": "support@devinterview.app"
  },
  "Authentication": {
    "Google": { "ClientIds": [] }
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@devinterview.app",
    "FromName": "DevInterview",
    "Host": "",
    "Port": 587,
    "EnableSsl": true
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "PlanLimits": {
    "FreeDailyQuestionViews": 40,
    "FreeDailyCodeRuns": 30,
    "FreeDailyCodeSubmissions": 15,
    "PremiumDailyCodeRuns": 300,
    "PremiumDailyCodeSubmissions": 150,
    "PremiumDailyAnswerEvaluations": 40,
    "PremiumDailyCodeReviews": 30,
    "PremiumDailyCodeExplanations": 30,
    "PremiumDailyMockInterviews": 6,
    "AdminDailyQuestionGenerations": 50,
    "FreeMaxQuizQuestions": 20
  },
  "RateLimits": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "AiPerMinute": 12,
    "CodePerMinute": 20
  },
  "AI": {
    "ProviderOrder": [ "Anthropic", "OpenAI" ],
    "TimeoutSeconds": 90,
    "MaxRetries": 2,
    "MaxInputCharacters": 12000,
    "Providers": {
      "Anthropic": {
        "Model": "claude-opus-5-5",
        "Effort": "medium",
        "InputCostPerMillionTokens": 4.0,
        "OutputCostPerMillionTokens": 20.0
      },
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "Model": "",
        "InputCostPerMillionTokens": 0,
        "OutputCostPerMillionTokens": 0
      }
    }
  },
  "CodeExecution": {
    "Provider": "Disabled",
    "DockerPath": "docker",
    "MaxConcurrentExecutions": 4,
    "CpuLimit": 1.0,
    "PidsLimit": 64,
    "OutputLimitBytes": 65536,
    "Languages": {
      "python": { "Image": "python:3.12-slim", "SourceFile": "main.py", "Compile": "python3 -m py_compile main.py", "Run": "python3 main.py", "StartupAllowanceMs": 200 },
      "javascript": { "Image": "node:22-slim", "SourceFile": "main.js", "Compile": "node --check main.js", "Run": "node main.js", "StartupAllowanceMs": 300 },
      "cpp": { "Image": "gcc:14", "SourceFile": "main.cpp", "Compile": "g++ -O2 -std=c++17 -o main main.cpp", "Run": "./main", "CompileTimeoutSeconds": 30 },
      "java": { "Image": "eclipse-temurin:21-jdk", "SourceFile": "Main.java", "Compile": "javac Main.java", "Run": "java -Xss64m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 Main", "StartupAllowanceMs": 800 },
      "kotlin": { "Image": "devinterview/sandbox-kotlin:2.0", "SourceFile": "main.kt", "Compile": "kotlinc main.kt -include-runtime -d main.jar 2>&1", "Run": "java -Xss64m -XX:+UseSerialGC -jar main.jar", "CompileTimeoutSeconds": 90, "StartupAllowanceMs": 800 },
      "csharp": { "Image": "mcr.microsoft.com/dotnet/sdk:8.0", "SourceFile": "Main.cs", "Compile": "sh /work/compile-csharp.sh", "Run": "dotnet main.dll", "CompileTimeoutSeconds": 60, "StartupAllowanceMs": 600 },
      "sql": { "Image": "python:3.12-slim", "SourceFile": "main.sql", "Run": "python3 sql_runner.py", "StartupAllowanceMs": 200 }
    },
    "Judge0": {
      "BaseUrl": "",
      "LanguageIds": { "python": 71, "javascript": 63, "cpp": 54, "java": 62, "csharp": 51, "kotlin": 78 }
    }
  },
  "Firebase": { "ProjectId": "", "CredentialsPath": "" },
  "Billing": { "GooglePlay": { "PackageName": "com.devinterview.app", "ServiceAccountPath": "", "NotificationSecret": "" } },
  "BackgroundJobs": { "Enabled": true },
  "Swagger": { "Enabled": true },
  "Seed": { "Enabled": true }
}
