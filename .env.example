# Copy to .env (git-ignored) for docker compose. Never commit real values.
# SQL Server SA password: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
# JWT signing key: at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=
# First Super Admin account created on startup (password must meet the password policy).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Optional AI providers (leave empty to disable AI features).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required when OPENAI_API_KEY is set (a model served by the OpenAI-compatible endpoint).
OPENAI_MODEL=
